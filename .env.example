# ============================================================
# WaadCare System — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in values before running
# NEVER commit the real .env file to version control
# ============================================================

# ── Database ─────────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Spring Profile: use "prod" for production, "dev" for local ─
SPRING_PROFILES_ACTIVE=prod

# ── JWT Secret (min 64 characters, random) ────────────────────
JWT_SECRET=CHANGE_ME_AT_LEAST_64_CHARACTERS_RANDOM_SECRET_STRING_HERE_XXXX
# Used only to create a superadmin on a fresh database.
# Leave sync disabled for existing databases.
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_UNIQUE_ADMIN_PASSWORD
ADMIN_SYNC_PASSWORD_ON_STARTUP=false
JWT_EXPIRATION_MS=1800000
SESSION_TIMEOUT=30m
# Base64 of exactly 32 random bytes. Keep stable; rotating it requires
# re-encrypting persisted SMTP/IMAP credentials first.
APP_SECRET_ENCRYPTION_KEY=CHANGE_ME_BASE64_ENCODED_32_BYTE_KEY

# ── Frontend URL (used in email links) ────────────────────────
VITE_API_URL=https://your-domain.com/api/v1
# Used only by the local Vite development proxy.
VITE_DEV_API_TARGET=http://127.0.0.1:8080

# ── Email (SMTP) ──────────────────────────────────────────────
EMAIL_ENABLED=true
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_USERNAME=support@alwahacare.com
EMAIL_PASSWORD=CHANGE_ME_EMAIL_PASSWORD
EMAIL_FROM=support@alwahacare.com
EMAIL_FROM_NAME=شركة وعد لإدارة النفقات الطبية

# ── Security tuning (optional, defaults shown) ────────────────
REQUIRE_EMAIL_VERIFICATION=false
ACCOUNT_LOCKOUT_DURATION_MINUTES=30
MAX_FAILED_LOGIN_ATTEMPTS=5
PASSWORD_RESET_TOKEN_VALIDITY_HOURS=1
EMAIL_VERIFICATION_TOKEN_VALIDITY_HOURS=24

# ── File uploads ──────────────────────────────────────────────
SPRING_MULTIPART_MAX_FILE_SIZE=60MB
SPRING_MULTIPART_MAX_REQUEST_SIZE=60MB
FILE_STORAGE_LOCAL_BASE_PATH=/app/uploads
